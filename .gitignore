# ── Corpus data ────────────────────────────────────────────────
# Source archives are 1.6 GB total; individual files exceed GitHub's
# 100 MB per-file limit. They are re-obtainable by running the
# scrapers in data/, and belong in object storage, not in git.
*.zip
data/*.zip

# Scraper output and extraction staging
data/output/
data/**/output/
data/**/Laws/
data/**/Acts/
data/**/Rules/
data/*_code/
data/Federal Laws/
*.log
scraper.log

# Manifests are small and useful, but re-generated on every run.
# Uncomment to track them if you want reproducibility receipts in git.
# !data/**/manifest.csv

# ── Built corpus artefacts ─────────────────────────────────────
*.sqlite
*.sqlite3
*.db
pack*.sqlite
*.dump
*.backup
pgdata/
backup-repo/


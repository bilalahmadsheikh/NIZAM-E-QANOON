# Layer boundaries for Nizam-e-Qanoon, enforced in CI.
#
# These contracts encode docs/01-master-architecture.html §6 and §8. They are the
# reason the dependency graph in Figure 8 will still be true in six months.
#
#   pip install import-linter && lint-imports
#
# Run it as `python tools/lint_layers.py` (./nz layers): the contracts name every
# layer docs/01 defines, and L4/L5 (nizam.generation, nizam.domain) are not built
# yet, so the wrapper drops modules that do not exist from a temporary copy and
# runs lint-imports on that. A module appears in the check the day it exists.

[importlinter]
root_package = nizam
include_external_packages = True


# ── 1. The read chain ─────────────────────────────────────────────────────
# Highest first. A layer may import anything below it and nothing above it.
# Skipping a level downward is permitted where §4.1 documents the contract
# (L6 reads ICorpusRead directly, for instance); reaching upward never is.

[importlinter:contract:read-chain]
name = Read chain runs one way only
type = layers
layers =
    nizam.api
    nizam.domain
    nizam.generation
    nizam.retrieval
    nizam.storage


# ── 2. Corpus is a writer, not a participant ──────────────────────────────
# L1 sits above storage (it writes through ICorpusWrite) but must never know
# that retrieval, generation, services or the API exist.

[importlinter:contract:corpus-is-terminal]
name = Corpus knows only storage
type = forbidden
source_modules =
    nizam.corpus
forbidden_modules =
    nizam.retrieval
    nizam.generation
    nizam.domain
    nizam.api


# ── 3. shared/ holds no domain logic ──────────────────────────────────────
# Config, error taxonomy, identifier generation, tracing, feature flags.
# It is the one package every layer may import, so it must import none of them.

[importlinter:contract:shared-is-leaf]
name = Shared imports nothing from the project
type = forbidden
source_modules =
    nizam.shared
forbidden_modules =
    nizam.corpus
    nizam.storage
    nizam.retrieval
    nizam.generation
    nizam.domain
    nizam.api


# ── 4. ADR-2: the vendor SDK lives in exactly one adapter ─────────────────
# The provider port is what makes "swap the model provider with a config
# change" a property of the structure rather than a promise. If this contract
# is ever relaxed, QA-11 is no longer true.

[importlinter:contract:provider-port]
name = Vendor SDKs only inside generation.providers
type = forbidden
source_modules =
    nizam.corpus
    nizam.storage
    nizam.retrieval
    nizam.domain
    nizam.api
    nizam.shared
    nizam.workers
forbidden_modules =
    anthropic
    openai
ignore_imports =
    nizam.generation.providers.* -> anthropic
    nizam.generation.providers.* -> openai
# the adapters do not exist until L4 is built: an exemption with nothing to exempt yet is not an error
unmatched_ignore_imports_alerting = none


# ── 5. INV-4: chunk identifiers are private to L2 ─────────────────────────
# Nothing above storage may reference a chunk. Provisions are the citable
# unit, so a re-chunk must not be able to invalidate a stored citation.

[importlinter:contract:chunks-are-private]
name = Chunk internals do not escape storage
type = forbidden
source_modules =
    nizam.retrieval
    nizam.generation
    nizam.domain
    nizam.api
forbidden_modules =
    nizam.storage.chunking
    nizam.workers.chunk


# ── 6. Database drivers stay in storage ───────────────────────────────────
# One datastore, reached one way (ADR-1). A raw driver import above L2 means
# someone is bypassing the repositories.

[importlinter:contract:db-in-storage]
name = Database drivers only inside storage
type = forbidden
# a RAW driver import is the violation; reaching the database through a storage repository (which itself imports
# psycopg) is the design (18 Nov 2026: without this, every L3/L6 import of nizam.storage counted as a driver import)
allow_indirect_imports = True
source_modules =
    nizam.corpus
    nizam.retrieval
    nizam.generation
    nizam.domain
    nizam.api
    nizam.shared
forbidden_modules =
    psycopg
    psycopg2
    sqlalchemy


# ── 7. The shared inference worker is a leaf (D-098) ──────────────────────
# docs/01 layer rule: "a layer calls only the layer immediately below it, plus the shared inference worker". Every
# layer may call it, so it may call none of them: it turns text into vectors and knows nothing of provisions,
# chunks or the database.

[importlinter:contract:inference-is-leaf]
name = The inference worker imports nothing from the project's layers
type = forbidden
source_modules =
    nizam.inference
forbidden_modules =
    nizam.corpus
    nizam.storage
    nizam.retrieval
    nizam.api
    nizam.workers
    psycopg

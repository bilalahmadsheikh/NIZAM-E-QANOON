# `./nz bootstrap` copies this to infra/.env and fills the three passwords with
# generated values. Doing it by hand is fine too:
#   cp infra/.env.example infra/.env   # then set the three empty passwords
# infra/.env is gitignored. Every service binds to 127.0.0.1 only.

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=nizam_clean
POSTGRES_USER=nizam
# required
POSTGRES_PASSWORD=
# 5433, not 5432: the Windows PostgreSQL service already owns 5432
POSTGRES_PORT=5433

# --- pgAdmin: the database browser -------------------------------------------
# .local is reserved for mDNS (RFC 6762) and pgAdmin refuses it
PGADMIN_EMAIL=dev@nizam.pk
# required, min 6 chars
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# --- Blob store (MinIO locally, Cloudflare R2 in production) ------------------
MINIO_ROOT_USER=nizam
# required, min 8 chars
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Corpus ------------------------------------------------------------------
# Where tools/corpus-land/land.py wrote the blob store, as WSL sees it.
# E:\nizam-data on Windows is /mnt/e/nizam-data inside WSL.
# Source PDFs are read sequentially once, so NTFS is fine for these -- unlike
# pgdata, which stays in a named volume on ext4 (doc 09a §1.2).
CORPUS_ROOT=/mnt/e/nizam-data

# Snapshot retention. Pruning happens on whichever limit bites first: a count
# cap, and a total disk budget. The budget matters once the corpus is real --
# eight snapshots of today's 17 MB database is nothing, eight of the judgment
# corpus would be tens of gigabytes.
SNAPSHOT_KEEP=8
SNAPSHOT_BUDGET_GB=25

# How much must actually be written before a snapshot is worth taking. An idle
# PostgreSQL still nudges the WAL (autovacuum, stats, pg_dump itself), so the
# gate is distance in bytes rather than "did the LSN change at all".
SNAPSHOT_MIN_WAL_MB=1
# How quiet counts as "the write finished". Below this much movement between two
# checks, the database is considered settled and safe to dump.
SNAPSHOT_SETTLE_KB=64
